# Vercel Postgres / Neon connection string
# Vercel automatically sets POSTGRES_URL when you attach a Vercel Postgres / Neon database in Vercel Storage.
POSTGRES_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Resend API Key for sending real OTP emails (https://resend.com)
# If not provided, OTP codes are logged to console and shown in the UI for local development.
RESEND_API_KEY=re_your_api_key_here

# Secret used to sign session cookies (optional, defaults to auto-generated secret)
JWT_SECRET=super_secret_jwt_key_change_me_in_production
