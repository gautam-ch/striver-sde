# Vercel Postgres / Neon connection string
# Vercel automatically sets POSTGRES_URL when you attach a Vercel Postgres / Neon database in Vercel Storage.
POSTGRES_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option A (Recommended if you don't have a custom domain): Free Gmail SMTP (via App Passwords)
# Allows sending OTP emails to ANY recipient without owning a custom domain!
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop

# Option B: Resend API Key (https://resend.com)
# NOTE: Free Resend without a custom domain only delivers to the owner's email address.
# If Resend is blocked by domain restrictions, the app automatically falls back to displaying the OTP in the UI.
RESEND_API_KEY=re_your_api_key_here

# Secret used to sign session cookies (optional, defaults to auto-generated secret)
JWT_SECRET=super_secret_jwt_key_change_me_in_production
